# =============================
# 环境变量配置文件
# ⚠️ 请在此填写你的密钥，不要把此文件提交到 Git！
# =============================

# OpenAI API Key
# ⚠️ 必须填写！替换为你的真实密钥
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL 数据库连接字符串
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# ⚠️ 请修改为你的 PostgreSQL 配置
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/codementor
